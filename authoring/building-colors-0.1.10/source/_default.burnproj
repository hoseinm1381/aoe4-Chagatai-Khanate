		<NamedParameters>
			<Description i:nil="true" />
			<Name>Static RGO</Name>
			<Parameters xmlns:d4p1="http://schemas.datacontract.org/2004/07/Essence.Editor.Bridge.Burning" i:type="d4p1:RGOBurnParameters">
				<d4p1:IgnoreTeamTextureSwap>false</d4p1:IgnoreTeamTextureSwap>
			</Parameters>
		</NamedParameters>
